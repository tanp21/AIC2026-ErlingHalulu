# Docker Compose's own variables for the laptop media host. Copy to `.env` next to this
# file -- `.env` is gitignored, this template is not.
#
# This is the *Compose* environment. The application's own settings (the five logins, the
# role, the tunnel target the app dials) live in `.env.secure`, which is separate and also
# gitignored; `.env.secure.example` documents it. See docs/laptop-media-host.md.

# -- required: where teammates reach this machine ------------------------------------------
# The laptop's Ethernet address on the switch -- NOT the WiFi one. The ingress binds only
# this address, so the app is not published on the venue WiFi, where nothing needs inbound
# access: DRES submission and the compute tunnel are both outbound connections.
#
# Find it with `ipconfig` (Windows) or `ip -4 addr` (Linux). A laptop that switches
# networks between venues needs this line updated each time; Compose refuses to start with
# an empty one rather than quietly publishing on every interface.
AIC_INGRESS_BIND=192.168.1.10

# -- required: the SSH link to the compute host --------------------------------------------
# The rented instance. compose.yaml's `core-tunnel` service holds this forward open; the
# app reaches the instance through it at AIC_CORE_URL (see .env.secure).
AIC_CORE_SSH_HOST=203.0.113.10
AIC_CORE_SSH_PORT=9182
AIC_CORE_SSH_USER=root
# Windows paths work with forward slashes. Docker Desktop must be allowed to read the
# drive this key is on (Settings > Resources > File sharing).
AIC_CORE_SSH_KEY=C:/Users/you/.ssh/id_ed25519_vast_caprl

# -- unused on the laptop, but they must be set --------------------------------------------
# compose.yaml guards the two model mounts with `${VAR:?}`, and Compose interpolates that
# file before compose.media.yaml discards the mounts -- so an unset variable fails the run
# even though nothing mounts it. Any non-empty value does; these are never read.
AIC_HF_HUB_DIR=C:/aic-unused/huggingface
AIC_VLM_DIR=C:/aic-unused/vlm

# -- sizing --------------------------------------------------------------------------------
# The container runs as this uid. Docker Desktop's Linux VM has a uid 1000, and Windows
# bind mounts are presented permissively, so the default is right on both backends.
AIC_UID=1000
AIC_GID=1000
# Lower than the desktop's 16g/8: a laptop is usually the smaller machine, and Windows
# needs its own share. Raise on a big one. ffmpeg concurrency is the other half of this and
# lives in `.env.secure` as AIC_THUMB_FFMPEG_SLOTS.
AIC_APP_MEM_LIMIT=12g
AIC_APP_CPUS=6
